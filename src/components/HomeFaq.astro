---
import { homeFaqCards } from '../data/faqs';
import { company, telUrl, whatsappUrl } from '../data/company';
---

<section class="home-faq-split" aria-labelledby="faq-section-title">
  <div class="wrap home-faq-split-inner">
    <!-- Left Column: Heading + Still Have Questions Card -->
    <div class="faq-left-col">
      <div class="faq-badge">
        <span class="faq-badge-dot" aria-hidden="true"></span>
        <span>Frequently Asked Questions</span>
      </div>

      <h2 id="faq-section-title" class="faq-split-title">
        Frequently asked<br />questions
      </h2>

      <aside class="faq-help-card">
        <h3>Still have questions?</h3>
        <p>
          Can’t find the answer to your question? Call the Kothagudem desk or send us a WhatsApp message and we’ll assist you right away!
        </p>
        <div class="faq-help-actions">
          <a href="/contact" class="faq-help-btn">
            <span>Contact Us</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href={telUrl} class="faq-help-tel" aria-label={`Call ${company.phoneDisplay}`}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>{company.phoneShort}</span>
          </a>
        </div>
      </aside>
    </div>

    <!-- Right Column: Accordion Cards -->
    <div class="faq-right-col">
      <div class="faq-accordion-list">
        {homeFaqCards.map((f, i) => (
          <details class="faq-card-item" open={i === 0}>
            <summary class="faq-card-summary">
              <span>{f.q}</span>
              <span class="faq-toggle-btn" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </span>
            </summary>
            <div class="faq-card-body">
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
