---
import Admin from '../../../layouts/Admin.astro';
import { company } from '../../../data/company';
---

<Admin title={`Blog desk | ${company.name}`}>
  <div class="admin-app" id="blog-admin" data-site={company.site}>
    <header class="admin-bar">
      <a class="admin-brand" href="/">
        <img src="/wordmark.svg" alt={company.name} width="168" height="42" />
      </a>
      <h1 id="admin-heading">Blog desk</h1>
      <div class="admin-bar-actions">
        <a class="btn btn-ghost" href="/blog">View blog</a>
        <button class="btn btn-ghost" type="button" id="logout" hidden>Log out</button>
      </div>
    </header>

    <p class="admin-boot" id="admin-boot">Opening the desk…</p>
    <noscript><p class="admin-boot">The blog desk needs JavaScript.</p></noscript>

    <section id="admin-login" class="admin-card" hidden>
      <h2>Sign in</h2>
      <p class="admin-lead">Write, update, and remove posts. Search fields are saved with each post.</p>
      <form id="login-form">
        <label>
          Password
          <input name="password" type="password" autocomplete="current-password" required />
        </label>
        <button class="btn btn-seal" type="submit">Enter</button>
        <p class="admin-hint" id="login-hint"></p>
        <p class="admin-status" id="login-status" role="status"></p>
      </form>
    </section>

    <section id="admin-list" hidden>
      <div class="admin-list-head">
        <p class="admin-lead">Published posts appear on the blog. Drafts stay off the list and the sitemap.</p>
        <button class="btn btn-seal" type="button" id="new-post">New post</button>
      </div>
      <p class="admin-status" id="list-status" role="status"></p>
      <div id="post-rows"></div>
    </section>

    <section id="admin-editor" hidden>
      <form id="editor-form" autocomplete="off">
        <div class="admin-actions">
          <button class="btn btn-seal" type="submit" id="save-post">Save</button>
          <a class="btn btn-ghost" id="view-post" href="/blog" target="_blank" rel="noopener" hidden>View</a>
          <button class="btn btn-ghost" type="button" id="back-to-posts">All posts</button>
          <button class="btn btn-ghost" type="button" id="delete-post" hidden>Delete</button>
        </div>
        <p class="admin-status" id="editor-status" role="status"></p>

        <div class="admin-editor-grid">
          <div class="admin-panel admin-fields">
            <h2>Post</h2>
            <label>
              Status
              <select name="status">
                <option value="draft">Draft</option>
                <option value="published">Published</option>
              </select>
            </label>
            <label>
              Heading
              <input name="title" maxlength="140" required />
            </label>
            <label>
              URL slug
              <input name="slug" maxlength="80" spellcheck="false" />
              <span class="admin-hint">Lowercase words separated by hyphens. This becomes /blog/your-slug.</span>
            </label>
            <div class="admin-split">
              <label>
                Author
                <input name="author" maxlength="80" />
              </label>
              <label>
                Publish date
                <input name="pubDate" type="date" />
              </label>
              <label>
                Updated date
                <input name="updatedDate" type="date" />
              </label>
            </div>
            <label>
              Excerpt
              <textarea name="excerpt" rows="3" maxlength="320"></textarea>
              <span class="admin-hint">Optional shorter line for the blog list. The meta description is used when this is empty.</span>
            </label>
            <label>
              Cover image
              <input name="coverImage" maxlength="400" placeholder="/blog/cover.jpg or https://" />
            </label>
            <div class="admin-inline">
              <label class="btn btn-ghost admin-upload">
                Upload cover
                <input id="cover-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
              </label>
            </div>
            <img id="cover-preview" alt="" hidden />
            <label>
              Cover alt text
              <input name="coverAlt" maxlength="180" />
            </label>
            <label>
              Body
              <textarea name="body" rows="18" spellcheck="true"></textarea>
              <span class="admin-hint">Markdown. Use ## for a heading and [text](/sell-gold) for a link.</span>
            </label>
          </div>

          <aside class="admin-panel admin-fields admin-seo">
            <h2>On-page SEO</h2>
            <label>
              Focus keyphrase
              <input name="focusKeyphrase" maxlength="80" />
              <span class="admin-hint">The phrase this page should rank for.</span>
            </label>
            <label>
              Search title
              <input name="seoTitle" maxlength="120" />
              <span class="admin-hint" id="count-title"></span>
            </label>
            <label>
              Meta description
              <textarea name="description" rows="4" maxlength="320"></textarea>
              <span class="admin-hint" id="count-description"></span>
            </label>
            <label>
              Keywords
              <input name="keywords" maxlength="300" />
              <span class="admin-hint">Comma-separated. Written into the keywords tag.</span>
            </label>
            <label>
              Canonical URL
              <input name="canonical" maxlength="400" placeholder="https://www.jathingold.com/blog/your-slug" />
              <span class="admin-hint">Leave empty to use this post’s own URL.</span>
            </label>
            <label>
              Indexing
              <select name="robots">
                <option value="index, follow">Index, follow</option>
                <option value="noindex, follow">Noindex, follow</option>
                <option value="noindex, nofollow">Noindex, nofollow</option>
              </select>
              <span class="admin-hint">Drafts stay off the public blog. A published noindex post stays on the site and out of the sitemap.</span>
            </label>
            <label>
              Social title
              <input name="ogTitle" maxlength="120" />
              <span class="admin-hint">Open Graph and Twitter title. Falls back to the search title.</span>
            </label>
            <label>
              Social description
              <textarea name="ogDescription" rows="3" maxlength="320"></textarea>
            </label>
            <label>
              Social image
              <input name="ogImage" maxlength="400" placeholder="https:// or /blog/image.jpg" />
            </label>
            <button class="btn btn-ghost" type="button" id="use-cover">Use cover as social image</button>

            <div class="serp">
              <p class="serp-label">Search preview</p>
              <p class="serp-title" id="serp-title"></p>
              <p class="serp-url" id="serp-url"></p>
              <p class="serp-desc" id="serp-desc"></p>
            </div>
            <ul class="seo-checks" id="seo-checks"></ul>
            <p class="admin-hint">These tags are stored on the page. The public robots.txt currently disallows every URL, so crawlers skip the site until that file changes.</p>
          </aside>
        </div>
      </form>
    </section>
  </div>
</Admin>

<script>
  import { mountBlogAdmin } from '../../../scripts/blog-admin';
  mountBlogAdmin();
</script>
