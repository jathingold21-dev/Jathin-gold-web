---
export const prerender = false;

import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { absUrl, blogPostingJsonLd, breadcrumbJsonLd, mediaUrl } from '../../lib/seo';
import { formatBlogDate } from '../../lib/format';
import { renderMarkdown } from '../../lib/markdown';
import { cookieName, isAuthed } from '../../server/blog-auth';
import { canReadLive } from '../../server/blog-backend';
import { readPost as readLivePost } from '../../server/blog-github';
import { BlogError } from '../../server/blog-store';

const slug = Astro.params.slug || '';
let live: Awaited<ReturnType<typeof readLivePost>> | null = null;
let missing = false;
if (canReadLive()) {
  try {
    live = await readLivePost(slug);
  } catch (err) {
    if (err instanceof BlogError && err.status === 404) missing = true;
    else console.error(err);
  }
}
const built = missing
  ? null
  : live
    ? null
    : (await getCollection('blog')).find((entry) => entry.id === slug) ?? null;
if (missing || (!live && !built)) {
  return new Response('<!doctype html><title>Not found</title><p>No page here. <a href="/blog">Blog</a></p>', {
    status: 404,
    headers: { 'content-type': 'text/html; charset=utf-8' },
  });
}

const data = live
  ? live
  : {
      title: built!.data.title,
      description: built!.data.description,
      excerpt: built!.data.excerpt,
      pubDate: built!.data.pubDate,
      updatedDate: built!.data.updatedDate || built!.data.pubDate,
      author: built!.data.author,
      status: built!.data.status,
      seoTitle: built!.data.seoTitle,
      canonical: built!.data.canonical,
      robots: built!.data.robots,
      ogTitle: built!.data.ogTitle,
      ogDescription: built!.data.ogDescription,
      ogImage: built!.data.ogImage,
      keywords: built!.data.keywords,
      coverImage: built!.data.coverImage,
      coverAlt: built!.data.coverAlt,
    };
const authed = isAuthed(Astro.cookies.get(cookieName())?.value);
if (data.status !== 'published' && !authed) {
  return new Response('<!doctype html><title>Not found</title><p>No page here. <a href="/blog">Blog</a></p>', {
    status: 404,
    headers: { 'content-type': 'text/html; charset=utf-8' },
  });
}

const liveHtml = live ? renderMarkdown(live.body) : '';
const Content = built ? (await render(built)).Content : null;
const path = `/blog/${slug}`;
const description = data.description || data.excerpt || data.title;
const canonical = data.canonical || undefined;
const pageUrl = data.canonical || absUrl(path);
const robots = data.status === 'draft' ? 'noindex, nofollow' : data.robots;
const image = mediaUrl(data.ogImage || data.coverImage);
const published = `${data.pubDate}T00:00:00.000Z`;
const modified = `${data.updatedDate || data.pubDate}T00:00:00.000Z`;
const showUpdated = Boolean(data.updatedDate && data.updatedDate !== data.pubDate);
---

<Base
  title={data.seoTitle || data.title}
  description={description}
  path={path}
  robots={robots}
  canonical={canonical}
  ogTitle={data.ogTitle || undefined}
  ogDescription={data.ogDescription || undefined}
  ogImage={image}
  ogType="article"
  keywords={data.keywords || undefined}
  published={published}
  modified={modified}
  jsonLd={[
    blogPostingJsonLd({
      title: data.title,
      description,
      datePublished: published,
      dateModified: modified,
      image,
      keywords: data.keywords || undefined,
      author: data.author,
      canonical: pageUrl,
    }),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog' },
      { name: data.title, path },
    ]),
  ]}
>
  <article>
    <header class="wrap blog-post">
      <p class="crumbs"><a href="/">Home</a> / <a href="/blog">Blog</a></p>
      {data.status === 'draft' ? <p class="blog-draft">Draft</p> : null}
      <p class="blog-kicker">
        <time datetime={data.pubDate}>{formatBlogDate(data.pubDate)}</time>
        <span aria-hidden="true"> · </span>
        {data.author}
        {showUpdated && data.updatedDate ? (
          <>
            <span aria-hidden="true"> · </span>
            Updated {formatBlogDate(data.updatedDate)}
          </>
        ) : null}
      </p>
      <h1>{data.title}</h1>
      {description ? <p class="lede">{description}</p> : null}
      {data.coverImage ? (
        <figure class="blog-cover">
          <img src={data.coverImage} alt={data.coverAlt || ''} />
        </figure>
      ) : null}
    </header>
    <section class="band band-ticket">
      <div class="wrap prose">
        {liveHtml ? <div set:html={liveHtml} /> : Content && <Content />}
        <p><a href="/contact">Get a quote</a> · <a href="/sell-gold">Sell gold</a> · <a href="/calculator">Calculator</a></p>
      </div>
    </section>
  </article>
</Base>
