---
import Base from '../../layouts/Base.astro';
import BranchCard from '../../components/BranchCard.astro';
import { company } from '../../data/company';
import { branches } from '../../data/branches';
import { allBranchesJsonLd, breadcrumbJsonLd } from '../../lib/seo';
---

<Base
  title={`Visit Jathin Gold in Kothagudem`}
  description={`Visit Jathin Gold at ${branches[0].address}. Available in Andhra Pradesh and Telangana. Open 7 days.`}
  path="/branches"
  jsonLd={[allBranchesJsonLd(), breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Kothagudem', path: '/branches' }])]}
>
  <div class="wrap page-head">
    <p class="crumbs"><a href="/">Home</a> / Kothagudem</p>
    <h1>Kothagudem</h1>
    <p class="lede">{branches[0].address}. {company.hoursLabel}. Available in Andhra Pradesh and Telangana.</p>
  </div>
  <section class="band band-ticket">
    <div class="wrap split split-3">
      {branches.map((b) => <BranchCard branch={b} />)}
    </div>
  </section>
</Base>
