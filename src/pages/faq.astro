---
import Base from '../layouts/Base.astro';
import FaqList from '../components/FaqList.astro';
import { allFaqs } from '../data/faqs';
import { breadcrumbJsonLd, faqJsonLd } from '../lib/seo';
---

<Base
  title="Gold Buying FAQs"
  description="Documents, cash limits, XRF testing, silver, platinum, and whether Jathin Gold sells jewellery (it does not)."
  path="/faq"
  jsonLd={[
    faqJsonLd(allFaqs),
    breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'FAQ', path: '/faq' }]),
  ]}
>
  <div class="wrap page-head">
    <p class="crumbs"><a href="/">Home</a> / FAQ</p>
    <h1>Frequently asked questions</h1>
  </div>
  <section class="band band-ticket">
    <div class="wrap">
      <FaqList items={allFaqs} />
    </div>
  </section>
</Base>
