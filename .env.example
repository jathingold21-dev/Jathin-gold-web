# Optional. When set at build time, gold/silver/platinum use metals.dev (IBJA/MCX in INR).
METALS_DEV_API_KEY=

# Optional public form key from web3forms.com. If empty, the form opens WhatsApp instead.
PUBLIC_WEB3FORMS_KEY=

# Password for /admin/blog. On Vercel this is required.
# If empty locally, the dev server uses a password and shows it on the sign-in screen.
ADMIN_PASSWORD=

# Production only. A GitHub token that can read and write this repository.
# Vercel uses it to save posts from the live desk.
GITHUB_TOKEN=
# GITHUB_REPO=jathingold21-dev/Jathin-gold-web
# GITHUB_BRANCH=main
