# Optional. When set at build time, gold/silver/platinum use metals.dev (IBJA/MCX in INR).
METALS_DEV_API_KEY=

# Optional public form key from web3forms.com. If empty, the form opens WhatsApp instead.
PUBLIC_WEB3FORMS_KEY=

# Password for /admin/blog while `npm run dev` is running.
# If empty, the dev server uses a local password and shows it on the sign-in screen.
ADMIN_PASSWORD=
